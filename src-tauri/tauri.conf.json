{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PC Tracker",
  "version": "0.1.0",
  "identifier": "com.pctracker.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PC Tracker",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/WebView2Loader.dll": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4MDAzQkZDNjk0RjY1NTUKUldSVlpVOXAvRHNBcUJ4QmZqbVpyNjNGN0l4ZFZONUplRjd4OU90M3BmbWIwbThzaE1CQjBMT1oK",
      "endpoints": [
        "https://github.com/collabwithglab-rgb/pc-tracker/releases/latest/download/latest.json"
      ]
    }
  }
}
